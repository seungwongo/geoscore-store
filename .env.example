# Gmail (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GOOGLE_MAIL=you@example.com
GOOGLE_PASSWORD=your_gmail_app_password
NOTIFY_EMAIL=owner@example.com

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paddle (Billing)
# PADDLE_ENV: "sandbox" or "production"
PADDLE_ENV=sandbox
# Client-side token from Paddle > Developer Tools > Authentication
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Price ID for the one-time GeoScore purchase (pri_...)
NEXT_PUBLIC_PADDLE_PRICE_ID=
# Server-side API key from Paddle > Developer Tools > Authentication
PADDLE_API_KEY=
# Webhook signing secret from Paddle > Developer Tools > Notifications (pdl_ntfset_...)
PADDLE_WEBHOOK_SECRET=

# Secret used to sign download tokens (any long random string, server-only)
DOWNLOAD_TOKEN_SECRET=

# Supabase (downloads table + analytics + admin auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard: credentials are validated against Supabase Auth (auth.users).
# Optional secret for signing the admin session cookie (falls back to
# DOWNLOAD_TOKEN_SECRET if unset).
ADMIN_SESSION_SECRET=
